# Production Environment Variables
# Copy to Cloudflare Pages Environment Variables (Settings → Environment variables)

# Supabase (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# For Cloudflare Workers API routes
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (SERVER-SIDE ONLY - Cloudflare Workers secret)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Credentials (Cloudflare Pages secrets)
# ADMIN_EMAIL=admin@sealify.ng
# ADMIN_PASSWORD=your-secure-password
# ADMIN_PIN=your-6-digit-pin

# VAPID Keys for Push Notifications
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# Node Configuration
NODE_VERSION=20
NODE_ENV=production