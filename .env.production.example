# Production Environment Variables
# Copy to Cloudflare Pages Environment Variables (Settings → Environment variables)

# Supabase (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google AdSense slot IDs (optional; ads remain hidden until configured)
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_LISTINGS=
VITE_ADSENSE_SLOT_LISTINGS_SIDEBAR=
VITE_ADSENSE_SLOT_LISTING_DETAIL=

# For Cloudflare Workers API routes
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (SERVER-SIDE ONLY - Cloudflare Workers secret)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI provider configuration (SERVER-SIDE ONLY)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# AI_WEB_SEARCH_ENABLED=true
# AI_FALLBACK_ENABLED=false
#
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# AI_WEB_SEARCH_ENABLED=true
# AI_FALLBACK_ENABLED=false

# Admin Credentials (Cloudflare Pages secrets)

# VAPID Keys for Push Notifications
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# Node Configuration
NODE_VERSION=20
NODE_ENV=production
