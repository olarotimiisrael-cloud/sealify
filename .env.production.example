# Production Environment Variables
# Copy to .env.production (gitignored) for local builds.
# For CI/CD, set the same values as build-time secrets.

# Supabase (Required - public anon values; safe to ship to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Production API base URL (Render backend)
# Must point at the migrated Render backend, NOT Cloudflare Functions.
VITE_API_URL=https://sealify-api.onrender.com

# Optional: Google AdSense slot IDs (ads remain hidden until configured)
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_LISTINGS=
VITE_ADSENSE_SLOT_LISTINGS_SIDEBAR=
VITE_ADSENSE_SLOT_LISTING_DETAIL=

# Node Configuration
NODE_VERSION=20
NODE_ENV=production
