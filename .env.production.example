# PRODUCTION ENVIRONMENT VARIABLES
# Copy these to Cloudflare Pages Dashboard → Settings → Environment Variables

# Supabase (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Payment Gateways (REQUIRED for payments)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx
MONNIFY_SECRET_KEY=MK_TEST_xxxxx

# Email Service (REQUIRED for notifications)
RESEND_API_KEY=re_xxxxx
SENDGRID_API_KEY=SG.xxxxx

# Push Notifications (REQUIRED for PWA push)
VAPID_PUBLIC_KEY=xxxxxx
VAPID_PRIVATE_KEY=xxxxxx

# Error Tracking
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Analytics
POSTHOG_KEY=phc_xxxxx

# App Config
VITE_SITE_URL=https://sealify.ng
NODE_VERSION=20
NODE_ENV=production

# Security
JWT_SECRET=your-super-secret-jwt-key-here
ENCRYPTION_KEY=your-32-char-encryption-key-here