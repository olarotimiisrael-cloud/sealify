# Additional Environment Variables for New Features

# OpenAI API Key (required for AI summarization)
OPENAI_API_KEY=your_openai_api_key_here

# MediaSoup Configuration
MEDIASOUP_INTERNAL_IP=127.0.0.1
MEDIASOUP_EXTERNAL_IP=your_server_public_ip

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg

# Storage (AWS S3 for video recordings)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sealify-video-recordings

# Redis for caching and queue
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue Workers
QUEUE_CONNECTION=redis

# Flutterwave Payment Gateway
FLUTTERWAVE_PUBLIC_KEY=FLWPUB_TEST_8eqijxd7cmv1
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_YOUR_SECRET_KEY_HERE
FLUTTERWAVE_WEBHOOK_SECRET=FLWSECK_TEST_WEBHOOK_SECRET

# Promotion Plans (per month in NGN)
PROMOTION_PLAN_BASIC_RATE=5000
PROMOTION_PLAN_STANDARD_RATE=10000
PROMOTION_PLAN_PREMIUM_RATE=20000
PROMOTION_PLAN_ENTERPRISE_RATE=50000

# Verification Settings
VERIFICATION_REQUIRED_FOR_PROMOTION=true
VERIFICATION_ID_TYPES=nin,bvn,voters_card,drivers_license,international_passport
VERIFICATION_EXPIRATION_DAYS=365

# Payment Callback URLs
PAYMENT_SUCCESS_URL=https://sealify.ng/payment/success
PAYMENT_CANCEL_URL=https://sealify.ng/payment/cancel