{
  "name": "sealify/sealify-api",
  "type": "project",
  "description": "Sealify marketplace Laravel API backend",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0|^12.0|^13.0",
    "laravel/sanctum": "^4.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
