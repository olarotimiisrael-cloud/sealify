# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare (for API routes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key (SERVER-SIDE ONLY - never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: VAPID keys for push notifications
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# Optional: Admin credentials (for admin terminal)
# ADMIN_EMAIL=admin@sealify.ng
# ADMIN_PASSWORD=your-secure-password
# ADMIN_PIN=your-6-digit-pin

# Node version for Cloudflare Pages
NODE_VERSION=20
NODE_ENV=production