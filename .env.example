# Sealify Nigeria - Environment Variables
# Copy this file to .env and fill in your values

# Cloudflare Hyperdrive (Required for database access)
# Create a Hyperdrive configuration at https://dash.cloudflare.com/ and add the ID here
HYPERDRIVE_ID=<YOUR_HYPERDRIVE_ID>

# Supabase (Required)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider (Optional - for Copilot feature)
# Choose one: openai or gemini
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
AI_WEB_SEARCH_ENABLED=true
AI_FALLBACK_ENABLED=true

# SMS Provider (Optional - for phone OTP)
# Choose one: Termii, Arkesel, or Twilio
# Termii: https://termii.com
TERMII_API_KEY=your-termii-key
TERMII_SENDER_ID=Sealify

# Arkesel: https://arkesel.com
ARKESEL_API_KEY=your-arkesel-key
ARKESEL_SENDER_ID=Sealify

# Twilio: https://twilio.com
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM=+2340000000000

# WhatsApp Business API (Optional - for WhatsApp OTP)
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# Firebase Cloud Messaging (Optional - for push OTP)
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-fcm-sender-id

# Application URLs
APP_URL=https://sealify.ng
PUBLIC_SITE_URL=https://sealify.ng

# Node Environment
NODE_ENV=development

# Turnstile (Cloudflare bot protection)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here