# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare (for API routes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key (SERVER-SIDE ONLY - never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI provider configuration (SERVER-SIDE ONLY)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# AI_WEB_SEARCH_ENABLED=true
# AI_FALLBACK_ENABLED=false
#
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# AI_WEB_SEARCH_ENABLED=true
# AI_FALLBACK_ENABLED=false

# Optional: VAPID keys for push notifications
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# Optional: Admin credentials (for admin terminal)

# Node version for Cloudflare Pages
NODE_VERSION=20
NODE_ENV=production
