# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Backend URL (Express server)
# Local development: http://localhost:3000
# Render production: https://your-render-service.onrender.com
VITE_API_URL=http://localhost:3000

# Google AdSense slot IDs (optional; ads remain hidden until configured)
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_LISTINGS=
VITE_ADSENSE_SLOT_LISTINGS_SIDEBAR=
VITE_ADSENSE_SLOT_LISTING_DETAIL=

# Backend (Render/Express)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Service role key (SERVER-SIDE ONLY - never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI provider configuration (SERVER-SIDE ONLY)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# AI_WEB_SEARCH_ENABLED=true
# AI_FALLBACK_ENABLED=false
#
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# AI_WEB_SEARCH_ENABLED=true
# AI_FALLBACK_ENABLED=false

# Optional: VAPID keys for push notifications
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# Node version
NODE_VERSION=22
NODE_ENV=production
