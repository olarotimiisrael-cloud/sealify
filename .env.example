# ============================================================================
# SEALIFY NIGERIA - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your values
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE (Required)
# ----------------------------------------------------------------------------
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase (for Cloudflare Workers / API routes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Keep secret! Admin only.

# ----------------------------------------------------------------------------
# CLOUDFLARE (Required for deployment)
# ----------------------------------------------------------------------------
# Get these from: Cloudflare Dashboard → Workers & Pages → API Tokens
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# For Wrangler CLI
CLOUDFLARE_API_TOKEN=your-api-token

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
NODE_ENV=development
NODE_VERSION=20

# Site URL (update for production)
VITE_SITE_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# ADMIN CREDENTIALS (Change in production!)
# ----------------------------------------------------------------------------
# These are used as fallbacks if not set in localStorage
ADMIN_EMAIL=admin@sealify.ng
ADMIN_PASSWORD=sealify2024
ADMIN_PIN=123456

# ----------------------------------------------------------------------------
# PAYMENT PROVIDERS (Optional - for production)
# ----------------------------------------------------------------------------
# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxx
FLUTTERWAVE_ENCRYPTION_KEY=your-32-char-key

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Monnify
MONNIFY_API_KEY=your-api-key
MONNIFY_CONTRACT_CODE=your-contract-code
MONNIFY_SECRET_KEY=your-secret-key

# ----------------------------------------------------------------------------
# EMAIL SERVICE (Optional - for notifications)
# ----------------------------------------------------------------------------
# Resend (recommended)
RESEND_API_KEY=re_xxxxx

# Or SendGrid
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@sealify.ng

# ----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Optional)
# ----------------------------------------------------------------------------
# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@sealify.ng

# ----------------------------------------------------------------------------
# ANALYTICS & MONITORING (Optional)
# ----------------------------------------------------------------------------
# Sentry (error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=sealify-nigeria

# PostHog (product analytics)
POSTHOG_KEY=phc_xxxxx
POSTHOG_HOST=https://app.posthog.com

# ----------------------------------------------------------------------------
# EXTERNAL APIS (Optional)
# ----------------------------------------------------------------------------
# Google Maps (for location autocomplete)
GOOGLE_MAPS_API_KEY=your-api-key

# IP Geolocation (for fraud detection)
IPGEOLOCATION_API_KEY=your-api-key

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
ENABLE_AI_FEATURES=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=true
ENABLE_SENTRY=false