# Security Headers for Cloudflare Pages
# Apply to all routes

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://checkout.flutterwave.com https://www.paystack.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co https://api.flutterwave.com https://api.paystack.com wss://*.supabase.co; frame-src https://js.stripe.com https://checkout.flutterwave.com https://www.paystack.com; base-uri 'self'; form-action 'self';
*/

# Cache static assets aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker no cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Manifest
/manifest.json
  Cache-Control: public, max-age=86400

# API routes - no cache
/api/*
  Cache-Control: no-store, private
  Access-Control-Allow-Origin: https://sealify.ng
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
  Access-Control-Allow-Credentials: true

# Health check - allow caching
/api/health
  Cache-Control: public, max-age=60