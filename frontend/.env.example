# Sealify Nigeria - Environment Variables
# Copy this file to .env and fill in your values

# Application URLs
APP_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Laravel API (backend runs on http://localhost:8000)
VITE_API_BASE=/api

# Node Environment
NODE_ENV=development

# Turnstile (Cloudflare bot protection)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here
